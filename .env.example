# Copy to .env and adjust. Values here are for local development only.

# --- Database (PostGIS) ---
POSTGRES_USER=greenminds
POSTGRES_PASSWORD=greenminds
POSTGRES_DB=greenminds
DATABASE_URL=postgresql+psycopg://greenminds:greenminds@db:5432/greenminds

# --- Auth ---
# Use a long random value in any shared deployment:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173

# --- Demo data ---
# Seeds demo users / admin units / surveys on backend start (all flagged is_demo).
SEED_DEMO_DATA=true
DEMO_MODE=true
DEMO_PASSWORD=GreenMinds@2026

# --- Queue ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (S3; MinIO-compatible) ---
# S3_IMAGE=rustfs/rustfs:latest   # override the S3 server image if needed
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=greenminds
MINIO_SECRET_KEY=greenminds-secret
MINIO_BUCKET=greenminds
MINIO_SECURE=false

# --- Tiles / processing ---
TITILER_URL=http://localhost:8001
NODEODM_URL=http://nodeodm:3000

# --- Live video (MediaMTX) ---
# Source the ffmpeg relay pushes into MediaMTX (see tools/ffmpeg_stream_examples.md)
VIDEO_SOURCE_URL=rtsp://192.168.144.25:8554/main.264
MEDIAMTX_PATH=drone
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_HLS_URL=http://localhost:8888

# --- Telemetry (MAVLink) ---
# live   -> pymavlink on MAVLINK_URL (e.g. udp:0.0.0.0:14550 or serial:/dev/ttyUSB0:57600)
# sitl   -> UDP from the ArduPilot SITL container (compose profile "sim")
# replay -> play a recorded .tlog / JSON track
TELEMETRY_MODE=replay
MAVLINK_URL=udp:0.0.0.0:14550

# --- Profiles (config/cameras.yaml, config/aircraft.yaml) ---
CAMERA_PROFILE=survey3w_rgn
AIRCRAFT_PROFILE=agroscan_quad
